# F1 Replay Timing — Environment Variables
# Copy to .env and fill in your values

PORT=8000
DATA_DIR=/data

# Storage: "local" (default) or "r2"
# Local stores computed session data on disk. R2 reads pre-computed data from Cloudflare R2.
STORAGE_MODE=local

# Cloudflare R2 (only needed when STORAGE_MODE=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=f1timingdata

# Auto-precompute: which session types to fetch in the background during race weekends.
# Runs every 30 minutes Fri–Mon and downloads any matching session as soon as F1
# publishes data. Sessions not in this set are still fetched on-demand the first
# time you click them (with the usual 1–3 minute wait).
#   off        — disable, fetch everything on-demand only
#   race       — race + sprint
#   race+qual  — race, sprint, qualifying, sprint qualifying (default)
#   all        — every session including practice
AUTO_PRECOMPUTE=race+qual

# Optional — authentication
# AUTH_ENABLED=true
# AUTH_PASSPHRASE=your-passphrase

# Optional — photo sync feature (requires OpenRouter API key)
# OPENROUTER_API_KEY=your-key-here

# Optional — live car positions and telemetry. Signs in to the live stream with an
# F1 TV account (Access or higher) via FastF1 3.9+. Sign in once with
#   docker compose exec f1timing python -m fastf1 auth f1tv --authenticate
# and set F1_USERNAME / F1_PASSWORD so FastF1 can sign in again when the token expires.
# LIVE_F1TV_AUTH=true
# F1_USERNAME=
# F1_PASSWORD=

# Only needed for pre-compute script (not required at runtime)
# FASTF1_CACHE_DIR=/data/fastf1-cache

# Optional — retention sweep: set to false to stop this instance running the daily
# retention sweep. Useful when several instances share one storage bucket and only
# one should delete old sessions.
# RETENTION_SWEEP_ENABLED=true

# Optional — replay player: "static" (default; plays pre-chunked replay files in the
# browser) or "websocket" (the previous player, streamed from the server). Set to
# websocket to go back to the previous player if you have problems with the new one.
# Can also be overridden per tab with ?player=old / ?player=new.
# REPLAY_PLAYER=static
